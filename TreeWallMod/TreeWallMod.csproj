<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<DebugType>embedded</DebugType>

		<AssemblyName>TreeWallMod</AssemblyName>
		<RootNamespace>TreeWallMod</RootNamespace>
		<Version>1.0.0</Version>
		<Nullable>enable</Nullable>
		<Configurations>Release;Debug;</Configurations>

		<VersionSuffix Condition="'$(Configuration)' == 'Debug'">dev</VersionSuffix>
		<!-- TreeWall -->
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\**\*.*" />
	</ItemGroup>

	<Import Project="../AmongUs.props" />

	<Target Name="CopyDLLToPlugins" AfterTargets="Build">
		<Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFolder="C:\Users\Dk\Desktop\Modding among us\BepInEx\plugins" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
	</Target>
</Project>