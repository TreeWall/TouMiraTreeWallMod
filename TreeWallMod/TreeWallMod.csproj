<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<DebugType>embedded</DebugType>

		<AssemblyName>TreeWallMod</AssemblyName>
		<RootNamespace>TreeWallMod</RootNamespace>
		<Nullable>enable</Nullable>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<Configurations>Release;Debug;</Configurations>
		<IsBetaBuild>false</IsBetaBuild>
		<BetaSuffix>1</BetaSuffix>
		<DefineConstants Condition="'$(IsBetaBuild)' == 'true'">$(DefineConstants);IS_BETA</DefineConstants>

		<VersionPrefix>1.0.1</VersionPrefix>
		<VersionSuffix Condition="'$(Configuration)' == 'Debug'">dev</VersionSuffix>
		<VersionSuffix Condition="'$(IsBetaBuild)' == 'true'">beta-$(BetaSuffix)</VersionSuffix>
		<Version>$(VersionPrefix)-$(VersionSuffix)</Version>

		<!-- TreeWall -->
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\**\*.*" />
	</ItemGroup>

	<Import Project="../AmongUs.props" />

	<Target Name="CopyDLLToPlugins" AfterTargets="Build">
		<Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFolder="C:\Users\Dk\Desktop\Modding among us\BepInEx\plugins" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
	</Target>
</Project>